CACHE_ENABLED=false
DEFAULT_REDIS_TTL=900
UPSTASH_REDIS_REST_URL=YOUR_UPSTASH_REDIS_REST_URL
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REDIS_REST_TOKEN
PORT=4000

# Bearer token every request must send. Empty + ALLOW_ANONYMOUS=false fails closed with 503. Never commit a real token.
API_TOKEN=
# "true" serves requests with no token. Only for a trusted private network; leave false for a public URL.
ALLOW_ANONYMOUS=false
# Single origin echoed back in Access-Control-Allow-Origin. Empty sends no CORS header at all.
ALLOWED_ORIGIN=
# Comma-separated provider allowlist (reanime,anizone,aniwaves,...). Empty allows every provider.
ALLOWED_PROVIDERS=
# "true" enables GET /episodes/:anilistId (all providers at once). Leave false to force the per-provider route.
ALLOW_UNFILTERED_EPISODES=false
# "true" enables GET /captcha/mkissa. Leave false unless a real browser is solving the captcha.
ALLOW_MKISSA_CAPTCHA=false
# Positive integer enables rate limiting per minute, keyed by token (or client IP when anonymous). Empty disables it.
RATE_LIMIT_PER_MINUTE=
